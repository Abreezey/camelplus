class HawaiiVacationAnswer(BaseModel):
    filename: str
    june_13_plan: str

files_by_content = search_files("Hawaii")
files_by_name = search_files_by_filename("Hawaii")

files = []
for f in files_by_content + files_by_name:
    existing_ids = [existing.id_ for existing in files]
    if f.id_ not in existing_ids:
