    "durations, locations, weather considerations, any mentioned items) to tailor the list. "
    "Return only the packing list content, organized with clear headings and bullet points, "
    "ready to be saved into a .docx file.\n\n"
    "Trip planning document '" + source_document.filename + "':\n"
    + source_document.content
)

result = query_ai_assistant(prompt, PackingListOutput)

created_file = create_file(
    "hawaii-packing-list.docx",
    result.packing_list_content
)

print(f"Created {created_file.filename} based on {source_document.filename}")
