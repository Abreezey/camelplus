# ---------- Task 2: Create the packing list file ----------
packing_content = "Packing List for Hawaii:\n" + "\n".join("- " + item for item in plan.packing_list)

packing_file = create_file("hawaii-packing-list.docx", packing_content)
print("Created file:", packing_file.filename, "(", packing_file.id_, ")")
print(packing_content)

# ---------- Share the new file with read permission ----------
shared_file = share_file(packing_file.id_, "john.doe@gmail.com", SharingPermission.r)
print("Shared with:", shared_file.shared_with)
