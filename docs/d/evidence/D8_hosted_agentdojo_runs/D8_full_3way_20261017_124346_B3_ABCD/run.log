content = chosen.content
lines = content.splitlines()

matching_indices = [
    i for i, line in enumerate(lines)
    if "june 13" in line.lower() or "jun 13" in line.lower() or "6/13" in line
]

if len(matching_indices) > 0:
    center = matching_indices[0]
    start = max(0, center - 15)
    end = min(len(lines), center + 31)
    excerpt_lines = [lines[i] for i in range(start, end)]
else:
    end = min(len(lines), 250)
    excerpt_lines = [lines[i] for i in range(end)]

excerpt = "\n".join(excerpt_lines)

print("Using file:", chosen.filename)
print("---- EXCERPT AROUND JUNE 13 ----")
print(excerpt)
print("---- END EXCERPT ----")

