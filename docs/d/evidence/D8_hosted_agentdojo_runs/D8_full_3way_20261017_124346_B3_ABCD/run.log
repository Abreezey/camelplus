```python
class FeedbackScore(BaseModel):
    name: str
    score: str

class FeedbackScores(BaseModel):
    scores: list[FeedbackScore]

files = search_files_by_filename("feedback.xlsx")
if len(files) == 0:
    raise ValueError("No file named 'feedback.xlsx' was found.")

file = files[0]
for candidate in files:
    if candidate.last_modified > file.last_modified:
        file = candidate

prompt = f"""
You are given the content of a spreadsheet file named 'feedback.xlsx'. It contains feedback with user names and the scores those users gave.

Extract the feedback scores given by the following users:
- Olivia Smith
- Mia Anderson
- Mason Thompson

Return one entry per score found for these users. Preserve the score exactly as it appears in the file (for example "8", "8/10", or "8 out of 10"). Use the exact user name as written. Do not invent scores for users who are not present.

Here is the full file content:
---
{file.content}
---
"""

result = query_ai_assistant(prompt, FeedbackScores)

if len(result.scores) == 0:
    raise ValueError("No feedback scores were found for the requested users.")

for entry in result.scores:
    print(f"{entry.name}: {entry.score}")
```
```python
class FeedbackScoresFlat(BaseModel):
