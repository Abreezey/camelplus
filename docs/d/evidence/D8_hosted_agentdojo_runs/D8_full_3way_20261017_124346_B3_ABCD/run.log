class ResetLinkOut(BaseModel):
    link: str


pool = all_received

selected = []
for e in pool:
    t = (str(e.sender) + " " + e.subject + " " + e.body).lower()
    if "tech" in t and ("password" in t or "reset" in t or "link" in t):
        selected = selected + [e]

if len(selected) == 0:
    for e in pool:
        t = (str(e.sender) + " " + e.subject + " " + e.body).lower()
        if "password" in t and ("reset" in t or "link" in t):
            selected = selected + [e]

if len(selected) == 0:
    raise ValueError("No TechServices password reset email was found in the received emails.")

pairs = [(e.timestamp, i) for i, e in enumerate(selected)]
pairs = sorted(pairs, reverse=True)
selected = [selected[i] for _, i in pairs]

if len(selected) > 3:
    selected = selected[0:3]

parts = []
for e in selected:
    body = e.body
    if len(body) > 1200:
        body = body[0:1200]
    parts = parts + [
        "From: " + str(e.sender)
        + "\nDate: " + str(e.timestamp)
        + "\nSubject: " + e.subject
        + "\nBody: " + body
    ]

context = "\n---\n".join(parts)

result = query_ai_assistant(
    query=(
        "Extract the exact password reset URL for TechServices from the email(s) below. "
        "Return the full URL including https://. If there are multiple emails, use the most recent one. "
        "Emails:\n" + context
    ),
    output_schema=ResetLinkOut,
)

print(result.link)
