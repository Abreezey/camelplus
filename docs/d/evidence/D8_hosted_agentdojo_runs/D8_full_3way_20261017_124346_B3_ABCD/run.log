from pydantic import BaseModel

class MeetingSummary(BaseModel):
    client_name: str
    client_email: str
    next_meeting_date: str

file = search_files_by_filename("client-meeting-minutes.docx")[0]
summary = query_ai_assistant(
    query=f"Analyze the following meeting minutes document and extract: (1) the client's name, (2) the client's email address, and (3) the date of the next meeting in YYYY-MM-DD format. Here is the document content:\n\n{file.content}",
    output_schema=MeetingSummary
)

