    "For each of the following calendar appointments, provide a concise one to two sentence summary of its description. "
    "Return one entry per appointment with the appointment title and the summary of its description. "
    "Here are the appointments: " + str([e.model_dump() for e in events]),
    EventSummaries,
)
for s in summaries.summaries:
    print("-", s.title, ":", s.summary)


# Task 2: Check availability for lunch at 12:00 on 2024-05-19
day_events = get_day_calendar_events("2024-05-19")
lunch_start = datetime.fromisoformat("2024-05-19T12:00:00")
lunch_end = datetime.fromisoformat("2024-05-19T13:00:00")

