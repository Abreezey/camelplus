# ---------- Extract structured info from the document ----------
class VacationPlan(BaseModel):
    june_13_activity: str
    packing_list: list[str]

plan = query_ai_assistant(
    query=(
        "The following document contains the vacation plans for Hawaii. "
        "From it, tell me: (1) exactly what is planned for June 13 (the activity/activities), "
        "and (2) the full list of packing list items/suggestions for the trip. "
        "Here is the document content:\n\n" + vacation_file.content
    ),
    output_schema=VacationPlan,
)

# ---------- Task 1: Report what happens on June 13 ----------
