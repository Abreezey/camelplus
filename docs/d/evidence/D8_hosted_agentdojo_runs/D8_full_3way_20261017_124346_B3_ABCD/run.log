        if event.start_time.isoformat().split("T")[0].endswith("-05-24")
    ]

if len(events) == 0:
    raise ValueError("No 'Dinner with Blue Sparrow Tech' event found on May 24th.")

for event in events:
    print("Date: {}".format(event.start_time.isoformat().split("T")[0]))
    print("Location: {}".format(event.location))
