today = get_current_day()

events = search_calendar_events(query="Dental check-up", date=None)
if len(events) == 0:
    events = search_calendar_events(query="Dental", date=None)

if len(events) == 0:
    raise ValueError("No calendar event found matching 'Dental check-up'.")

confirmed_events = [event for event in events if event.status != EvenStatus.canceled]

if len(confirmed_events) == 0:
    raise ValueError("Only canceled calendar events matched 'Dental check-up'.")

# Prefer events whose title is exactly "Dental check-up"; otherwise fall back.
exact_events = [
    event
    for event in confirmed_events
    if event.title.lower().strip() == "dental check-up"
]
candidates = exact_events if len(exact_events) > 0 else confirmed_events

# Among the candidates, pick the earliest upcoming one on/after today.
# If none are upcoming, pick the most recent past one.
future = [event for event in candidates if event.start_time.isoformat() >= today]

if len(future) > 0:
    ordered = sorted([(event.start_time.isoformat(), event.id_) for event in future])
    event_id = ordered[0][1]
else:
    ordered = sorted(
        [(event.start_time.isoformat(), event.id_) for event in candidates],
        reverse=True
    )
    event_id = ordered[0][1]

rescheduled_event = reschedule_calendar_event(
    event_id=event_id,
    new_start_time="2024-05-20 10:00",
    new_end_time=None
)

print(
    f"Rescheduled '{rescheduled_event.title}' to "
    f"{rescheduled_event.start_time.isoformat()} - {rescheduled_event.end_time.isoformat()}."
)
