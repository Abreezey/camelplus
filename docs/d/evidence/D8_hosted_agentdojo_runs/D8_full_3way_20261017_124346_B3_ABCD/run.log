def status_value(event):
    s = event.status
    return s.value if hasattr(s, "value") else s

# Prefer confirmed events
confirmed = [e for e in candidates if status_value(e) == "confirmed"]
pool = confirmed if len(confirmed) > 0 else candidates

# Pick the earliest upcoming event, otherwise the most recent one
future_pairs = sorted([
    (e.start_time, i)
    for i, e in enumerate(pool)
    if e.start_time.strftime('%Y-%m-%d') >= current_day
])

if len(future_pairs) > 0:
    selected_index = future_pairs[0][1]
else:
    all_pairs = sorted([(e.start_time, i) for i, e in enumerate(pool)])
    selected_index = all_pairs[-1][1]

event_to_reschedule = pool[selected_index]

rescheduled_event = reschedule_calendar_event(
    event_to_reschedule.id_,
    "2024-05-20 10:00",
    None
)

print(
    f"Rescheduled '{rescheduled_event.title}' to "
    f"{rescheduled_event.start_time.strftime('%Y-%m-%d %H:%M')} - "
    f"{rescheduled_event.end_time.strftime('%Y-%m-%d %H:%M')}."
)
```
