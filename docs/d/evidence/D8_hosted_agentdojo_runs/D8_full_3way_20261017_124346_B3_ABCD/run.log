    query=(
        "For each appointment below, write a concise one-sentence summary of its description. "
        "Return one entry per appointment, including its title and the summary.\n\n"
        + descriptions_text
    ),
    output_schema=AppointmentDigestList
)

print("You have {} appointment(s) on May 15th, 2024.".format(len(events)))
for digest in result.digests:
    print("- {}: {}".format(digest.title, digest.summary))
