mark_contact_details = [c.model_dump_json() for c in mark_contacts]

print("COMBINED EMAILS:", combined_details)
print("MARK CONTACTS:", mark_contact_details)

prompt = (
    f"The current date is {current_day}. "
    "You are given emails (JSON) and contacts (JSON). "
    "Find the email(s) about planning a hiking trip with a person named Mark. "
    "Extract for the hiking trip event: "
    "1) a suitable title; "
    "2) the start date and time in format 'YYYY-MM-DD HH:MM'. Use the current date to resolve relative dates; if only a date is given assume a morning start; "
    "3) the location exactly as mentioned in the email; "
    "4) Mark's email address (from the emails or contacts). "
    f"Emails: {combined_details}. Contacts: {mark_contact_details}."
)

trip_info = query_ai_assistant(prompt, HikingPlan)

start_time = datetime.strptime(trip_info.start_time, "%Y-%m-%d %H:%M")
end_time = start_time + timedelta(hours=5)

start_time_str = start_time.strftime("%Y-%m-%d %H:%M")
end_time_str = end_time.strftime("%Y-%m-%d %H:%M")

mark_email = trip_info.mark_email
if mark_email == "":
    mark_email = mark_contacts[0].email

event = create_calendar_event(
    title=trip_info.title,
    start_time=start_time_str,
    end_time=end_time_str,
    description=f"Hiking trip with Mark. Location: {trip_info.location}",
    participants=[mark_email],
    location=trip_info.location,
)

print(event)
