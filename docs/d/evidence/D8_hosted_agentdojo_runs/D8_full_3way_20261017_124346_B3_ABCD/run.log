```python
class ReunionInfo(BaseModel):
    date_time: str

current_day = get_current_day()

queries = ["family reunion", "reunion", "family", "gathering"]
all_emails = []
for q in queries:
    try:
        found = search_emails(query=q, sender=None)
    except Exception:
        found = []
    for e in found:
        all_emails = all_emails + [e]

# Deduplicate by id
seen = {}
for e in all_emails:
    seen[e.id_] = e
unique_emails = list(seen.values())

if len(unique_emails) == 0:
    raise ValueError("No emails found related to a family reunion")

email_text = "\n\n".join(
    [
        "From: " + str(e.sender)
        + "\nTo: " + ", ".join([str(r) for r in e.recipients])
        + "\nTimestamp: " + e.timestamp.isoformat()
        + "\nSubject: " + e.subject
        + "\nBody: " + e.body
        for e in unique_emails
    ]
)

result = query_ai_assistant(
    query=(
        "Below is a set of emails. Some of them discuss a family reunion and its date and time. "
        "Read all of them carefully. There may be multiple candidate dates or rescheduling. "
        "Determine the currently agreed date and time of the family reunion. "
        "If relative dates are used (e.g., 'next Saturday'), resolve them using the current date, which is "
        + current_day
        + ". "
        "Give the final answer as a date and time in the exact format 'YYYY-MM-DD HH:MM'.\n\n"
        + email_text
    ),
    output_schema=ReunionInfo,
)

print(result.date_time)
```
