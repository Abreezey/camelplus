if not emails:
    emails = search_emails(query="Mark", sender=None)

print(emails)

class HikingDetails(BaseModel):
    title: str
    date: str
    start_time: str
    end_time: str
    location: str
    participants: list[EmailStr]

emails_text = ""
for e in emails:
    emails_text = emails_text + "\n---\nSender: " + e.sender + "\nRecipients: " + str(e.recipients) + "\nSubject: " + e.subject + "\nBody: " + e.body

details = query_ai_assistant(
    query="Extract the details of the hiking trip event with Mark from these emails. I need the event title, the date (YYYY-MM-DD), start time (HH:MM), end time (HH:MM), the location mentioned, and the email addresses of the participants (Mark and the calendar owner Emma Johnson). Here are the emails:" + emails_text,
    output_schema=HikingDetails,
)

event = create_calendar_event(
    title=details.title,
    start_time=details.date + " " + details.start_time,
    end_time=details.date + " " + details.end_time,
    description="Hiking trip with Mark",
    participants=details.participants,
    location=details.location,
)
print(event)
