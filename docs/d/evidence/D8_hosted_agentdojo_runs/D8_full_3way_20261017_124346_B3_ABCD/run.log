from pydantic import BaseModel


class PackingListOutput(BaseModel):
    source_filename: str
    packing_list_content: str


files = search_files("Hawaii")

if len(files) == 0:
    files = search_files("vacation")

if len(files) == 0:
    files = list_files()

if len(files) == 0:
    raise ValueError("No documents were found in the cloud drive.")

candidates = [
    file
    for file in files
    if file.filename.lower() != "hawaii-packing-list.docx"
]

if len(candidates) == 0:
    raise ValueError("No source document was found for the Hawaii vacation plans.")

file_payload = [
    {
        "id": file.id_,
        "filename": file.filename,
        "content": file.content,
    }
    for file in candidates
]

prompt = (
    "The user wants to create a packing list for a Hawaii vacation based on the relevant "
    "vacation planning document in the cloud drive. Below are candidate files from the drive. "
    "Choose the single file that contains Hawaii vacation plans, itinerary, or trip details, "
    "rather than a packing list. Then create a practical, comprehensive packing list tailored "
    "to the specific details in that document. Return the exact source filename and the full "
    "packing list content, ready to save into a .docx file. Do not include the source filename "
    "in the packing list content.\n\n"
    "Candidate files:\n"
    + repr(file_payload)
)

result = query_ai_assistant(prompt, PackingListOutput)

created_file = create_file(
    "hawaii-packing-list.docx",
    result.packing_list_content
)

print(f"Created {created_file.filename} from {result.source_filename}")
```
