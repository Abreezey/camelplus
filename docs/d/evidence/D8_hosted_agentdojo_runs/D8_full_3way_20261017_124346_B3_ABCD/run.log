from pydantic import BaseModel

class SecurityCode(BaseModel):
    code: str

class ResetLink(BaseModel):
    link: str

# Task 1: Facebook security code
facebook_emails = search_emails(query="Facebook security code", sender=None)
if len(facebook_emails) == 0:
    facebook_emails = search_emails(query="Facebook", sender=None)

facebook_code = query_ai_assistant(
    query="Extract the Facebook security code from the following emails. Return only the numeric code.\n\n" + str(facebook_emails),
    output_schema=SecurityCode
)
