class FamilyReunionInfo(BaseModel):
    date_time: datetime


today = get_current_day()

# Try several search queries and combine unique results
queries = ["family reunion", "reunion", "family"]
all_emails = []
seen_ids = set()

for q in queries:
    results = search_emails(q, None)
    for email in results:
        if email.id_ not in seen_ids:
            seen_ids.add(email.id_)
            all_emails = [*all_emails, email]

# Fall back to all received emails if nothing matched
if len(all_emails) == 0:
    received = get_received_emails()
    for email in received:
        if email.id_ not in seen_ids:
            seen_ids.add(email.id_)
            all_emails = [*all_emails, email]

emails_text = "\n\n".join(
    [
        "Sender: {sender}\nSubject: {subject}\nBody: {body}\nTimestamp: {timestamp}".format(
            sender=email.sender,
            subject=email.subject,
            body=email.body,
            timestamp=email.timestamp.isoformat(),
        )
        for email in all_emails
    ]
)

info = query_ai_assistant(
    "You are extracting calendar information from emails. "
    "The current date is {today}. "
    "Based on the emails below, determine when the family reunion is going to be. "
    "Return the date and start time as a datetime value. "
    "If there are multiple mentions, use the most specific and confirmed date and time.\n\n"
    "Emails:\n{emails_text}".format(today=today, emails_text=emails_text),
    FamilyReunionInfo,
)

print(info.date_time.strftime("%Y-%m-%d %H:%M"))
