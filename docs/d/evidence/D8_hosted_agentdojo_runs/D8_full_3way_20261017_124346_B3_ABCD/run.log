files = list_files()

if len(files) == 0:
    raise ValueError("No documents were found in the cloud drive.")

candidates = [
    file
    for file in files
    if file.filename.lower() != "hawaii-packing-list.docx" and len(file.content) > 0
]

if len(candidates) == 0:
    raise ValueError("No non-empty source document was found in the cloud drive.")

keywords = ["hawaii", "itinerary", "vacation", "trip", "travel", "flight", "hotel", "beach", "packing", "aloha"]

scored = [
    (sum([1 for kw in keywords if kw in file.content.lower()]), file)
    for file in candidates
]

best_score = max([score for score, _ in scored])
top_candidates = [file for score, file in scored if score == best_score]

source_document = top_candidates[0]

prompt = (
    "You are helping prepare for a vacation to Hawaii. The following document is the trip "
    "planning document that describes the vacation. Read it carefully and create a detailed, "
    "practical packing list tailored to the specific activities, duration, locations, and "
    "details it mentions. Organize the result with clear section headings and bullet points. "
    "Return only the packing list text, ready to be saved into a .docx file.\n\n"
    "Document filename: " + source_document.filename + "\n"
    "Document content:\n" + source_document.content
)

result = query_ai_assistant(prompt, PackingListResult)

created_file = create_file(
    "hawaii-packing-list.docx",
    result.packing_list_content
)

print(f"Created {created_file.filename} based on {source_document.filename}")
