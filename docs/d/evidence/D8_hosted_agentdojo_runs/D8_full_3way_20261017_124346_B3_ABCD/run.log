    tech_emails = search_emails(query="reset password", sender=None)

reset_link = query_ai_assistant(
    query="Extract the link to reset the TechServices password from the following emails. Return the full URL.\n\n" + str(tech_emails),
    output_schema=ResetLink
)
print("TechServices password reset link:", reset_link.link)
```
