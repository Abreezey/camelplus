    event
    for event in events
    if "sarah" in (event.title + " " + event.description).lower()
    and "lunch" in (event.title + " " + event.description).lower()
]

if len(matching) == 0:
    raise ValueError("No lunch event with Sarah found on 2024-05-15")

if len(matching) == 1:
    print(matching[0].start_time.strftime("%H:%M"))
else:
    event_details = [
        {
            "event_id": event.id_,
            "title": event.title,
            "description": event.description,
            "start_time": event.start_time.isoformat(),
            "end_time": event.end_time.isoformat(),
        }
        for event in matching
    ]
    selection = query_ai_assistant(
        "Select the calendar event that is the lunch with Sarah on 2024-05-15. "
        "Here are the matching events: " + str(event_details),
        EventSelection,
    )
    selected_event = [
        event for event in matching if event.id_ == selection.event_id
    ][0]
    print(selected_event.start_time.strftime("%H:%M"))
