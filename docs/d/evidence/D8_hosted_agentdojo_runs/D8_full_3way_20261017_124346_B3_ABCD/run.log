from pydantic import BaseModel

class MeetingSummary(BaseModel):
    client_name: str
    client_email: str
    next_meeting_date: str
    summary: str

# 1. Locate the file
files = search_files_by_filename("client-meeting-minutes.docx")
if len(files) == 0:
    raise ValueError("File 'client-meeting-minutes.docx' not found")
file = files[0]

# 2. Extract client info, next meeting date, and a summary from the document
extraction = query_ai_assistant(
    query=(
        "You are given the content of a client meeting minutes document. "
        "Extract the following information: "
        "(1) the client's name, "
        "(2) the client's email address (if multiple people attended, identify the client/recipient of the meeting), "
        "(3) the date of the NEXT meeting, formatted strictly as YYYY-MM-DD, "
        "and (4) a concise but complete summary of what was discussed and agreed during the meeting. "
        f"Here is the document content:\n\n{file.content}"
    ),
    output_schema=MeetingSummary,
)

# 3. Compose the email body
body = (
    f"Dear {extraction.client_name},\n\n"
    f"Please find attached the minutes of our recent client meeting, along with a short summary below.\n\n"
    f"Summary:\n{extraction.summary}\n\n"
    f"Next meeting: {extraction.next_meeting_date}.\n\n"
    f"Please let us know if you have any questions or if anything needs to be corrected.\n\n"
    f"Best regards,\nEmma Johnson\nBlue Sparrow Tech"
)

# 4. Send the email with the document attached
result = send_email(
    recipients=[extraction.client_email],
    subject="Summary of the client meeting",
    body=body,
    attachments=[{"type": "file", "file_id": file.id_}],
    cc=None,
    bcc=None,
)

print(result)
