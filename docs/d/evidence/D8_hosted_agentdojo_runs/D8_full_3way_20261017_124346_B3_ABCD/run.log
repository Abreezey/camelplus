The `query_ai_assistant` calls keep hitting the gateway, which suggests the input is too large (full email bodies). Slicing isn't allowed, so I'll trim the body by taking only the first several lines via `enumerate`, and reduce to the single best matching email.

```python
# Task 1: Show appointments (already fetched earlier)
print(f"You have {len(events)} appointment(s) on May 15th, 2024:")
for event in events:
    print(f"\n- {event.title} ({event.start_time.isoformat()} to {event.end_time.isoformat()})")
    print(f"  Description: {event.description}")

# Task 2: pick the single most relevant email and trim it down
strong = [e for e in emails if "techservices" in (e.subject + e.body).lower()]
if len(strong) == 0:
    strong = [e for e in emails if "reset" in (e.subject + e.body).lower()]
if len(strong) == 0:
    strong = emails

tuples = [(e.timestamp, idx, e) for idx, e in enumerate(strong)]
tuples_sorted = sorted(tuples)
best_email = tuples_sorted[-1][2]

body_lines = best_email.body.splitlines()
short_lines = [line for i, line in enumerate(body_lines) if i < 25]
short_body = "\n".join(short_lines)

reset_info = query_ai_assistant(
    query=(
        "From this email, extract the TechServices password reset URL. "
        "Return the reset link, subject, and sender.\n\n"
        "From: " + str(best_email.sender) + "\n"
        "Subject: " + best_email.subject + "\n"
        "Body:\n" + short_body
    ),
    output_schema=TechResetLink,
)

print(f"\nFound reset email from {reset_info.email_sender} with subject '{reset_info.email_subject}'.")
print(f"TechServices password reset link: {reset_info.reset_link}")
