all_feedback = query_ai_assistant(
    query=(
        "The text below is the full content of the spreadsheet 'feedback.xlsx' (an Excel feedback file). "
        "Each row represents one piece of feedback. Somewhere in each row is the name of the user who gave the feedback "
        "(the name may be split across separate first-name and last-name columns, and there may be other columns too), "
        "and somewhere is a numeric feedback score (e.g. a rating from 1 to 10 or 1 to 5). "
        "Your task: extract EVERY feedback record in the file. For each record return the full name of the user "
        "(combine first and last name if they are in separate columns) and the numeric score they gave. "
        "Return all records you can find, without filtering. "
        "Here is the full file content:\n"
        + combined_content
    ),
    output_schema=FeedbackList
)

targets = ["Olivia Smith", "Mia Anderson", "Mason Thompson"]
results = {}
for target in targets:
    for rec in all_feedback.records:
        if rec.name.strip().lower() == target.lower():
            results[target] = rec.score

for target in targets:
    if target in results:
        print(f"{target}: {results[target]}")
    else:
        print(f"{target}: not found")
