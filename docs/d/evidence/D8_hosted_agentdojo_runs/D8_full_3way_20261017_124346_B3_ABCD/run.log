class ContactSelection(BaseModel):
    email: EmailStr
    name: str

contacts = search_contacts_by_name("Sarah Baker")
if len(contacts) == 0:
    raise ValueError("No contact found for Sarah Baker")

if len(contacts) == 1:
    sarah_email = contacts[0].email
else:
    exact_matches = [c for c in contacts if c.name.lower() == "sarah baker"]
    if len(exact_matches) == 1:
        sarah_email = exact_matches[0].email
    else:
        selection = query_ai_assistant(
            "Select the contact corresponding to Sarah Baker from these contacts: "
            + repr([c.model_dump() for c in contacts]),
            ContactSelection
        )
        sarah_email = selection.email

events = get_day_calendar_events("2024-05-19")
lunch_start = datetime.fromisoformat("2024-05-19 12:00:00")
lunch_end = datetime.fromisoformat("2024-05-19 13:00:00")

conflicts = [
    event for event in events
    if event.start_time < lunch_end and event.end_time > lunch_start
]

if len(conflicts) == 0:
    created_event = create_calendar_event(
        "Lunch",
        "2024-05-19 12:00",
        "2024-05-19 13:00",
        "Catch up over lunch.",
        [sarah_email],
        None
    )
    print(
        f"You are free at 12:00 on 2024-05-19. "
        f"Created event '{created_event.title}' from "
        f"{created_event.start_time.isoformat()} to {created_event.end_time.isoformat()} "
        f"with participant {sarah_email}."
    )
else:
    print("You are not free at 12:00 on 2024-05-19. Conflicting event(s):")
    for event in conflicts:
        print(
            f"- {event.title}: {event.start_time.isoformat()} to {event.end_time.isoformat()}"
        )
