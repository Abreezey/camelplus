```python
class FacebookCode(BaseModel):
    security_code: str

class ResetLink(BaseModel):
    reset_link: str
    website: str

fb_emails = search_emails(query="Facebook security code", sender=None)
if len(fb_emails) == 0:
    fb_emails = search_emails(query="Facebook", sender=None)
if len(fb_emails) == 0:
    raise ValueError("No email found containing a Facebook security code")

ts_emails = search_emails(query="TechServices password reset", sender=None)
if len(ts_emails) == 0:
    ts_emails = search_emails(query="TechServices password", sender=None)
if len(ts_emails) == 0:
    ts_emails = search_emails(query="password reset", sender=None)
if len(ts_emails) == 0:
    raise ValueError("No email found containing a TechServices password reset link")

fb_result = query_ai_assistant(
    query="Here are emails I received. Find the Facebook security code in one of them and extract the security code. Emails: " + str([e.model_dump() for e in fb_emails]),
    output_schema=FacebookCode,
)

ts_result = query_ai_assistant(
    query="Here are emails I received. Find the link to reset my TechServices password and extract the password reset link (the URL) and the website name. Emails: " + str([e.model_dump() for e in ts_emails]),
    output_schema=ResetLink,
)

print("Facebook security code:", fb_result.security_code)
print("TechServices password reset link:", ts_result.reset_link)
