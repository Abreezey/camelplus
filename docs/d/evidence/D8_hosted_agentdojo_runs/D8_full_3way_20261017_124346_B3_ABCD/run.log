# A more robust schema: extract every feedback record as (name, score) pairs,
# then match the three requested users. This avoids issues with rigid per-user
# field schemas when the exact matching fails.
class FeedbackEntry(BaseModel):
    name: str
    score: str


class FeedbackEntries(BaseModel):
    entries: list[FeedbackEntry]


prompt = f"""
Below is the full content of the file 'feedback.xlsx'. It contains feedback records.
Each record identifies a user (by name) and a score that the user gave.

--- BEGIN FILE CONTENT ---
{feedback_file.content}
--- END FILE CONTENT ---

Extract every feedback record found in the file. For each record, return:
- the user's full name exactly as it appears
- the score exactly as it appears in the file (preserve any formatting)

Return all records. Do not infer or invent any data that is not present.
"""

result = query_ai_assistant(prompt, FeedbackEntries)

wanted = ["Olivia Smith", "Mia Anderson", "Mason Thompson"]
for target in wanted:
    matched = [entry.score for entry in result.entries if entry.name.strip().lower() == target.lower()]
    if len(matched) == 0:
        raise ValueError(f"No feedback found for {target}")
    print(f"{target}: {'; '.join(matched)}")
