    name: str


day = "2024-05-19"
start = datetime.fromisoformat("2024-05-19T12:00:00")
end = datetime.fromisoformat("2024-05-19T13:00:00")

events = get_day_calendar_events(day)
conflicts = [
    event for event in events
    if event.status != EvenStatus.canceled
    and event.start_time < end
    and event.end_time > start
]

if conflicts:
    print(
        f"You are not free at 12:00 on {day}. Conflicting events: "
        + ", ".join([event.title for event in conflicts])
    )
else:
    contacts = search_contacts_by_name("Sarah Baker")
    if len(contacts) == 0:
        raise ValueError("No contact found for Sarah Baker")

    if len(contacts) == 1:
        sarah_email = contacts[0].email
    else:
        contact_details = [contact.model_dump() for contact in contacts]
        selected_contact = query_ai_assistant(
            query=(
                "The user wants to invite Sarah Baker to a lunch event. "
                "Select the correct contact from these search results: "
                + str(contact_details)
            ),
            output_schema=ContactChoice
        )
        sarah_email = selected_contact.email

    event = create_calendar_event(
        title="Lunch",
        start_time="2024-05-19 12:00",
        end_time="2024-05-19 13:00",
        description="Catch up over lunch.",
        participants=[sarah_email],
        location=None
    )

    print(
        f"Created event '{event.title}' from {event.start_time.isoformat()} "
        f"to {event.end_time.isoformat()} with Sarah Baker ({sarah_email})."
    )
