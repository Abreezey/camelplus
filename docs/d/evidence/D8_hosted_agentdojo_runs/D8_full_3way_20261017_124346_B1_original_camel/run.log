class SelectedFile(BaseModel):
    file_id: str

class SuggestedActivities(BaseModel):
    activity_1: str
    activity_2: str

files = search_files_by_filename("team-building-activities.docx")

if len(files) == 0:
    raise ValueError("No file named 'team-building-activities.docx' was found.")
elif len(files) == 1:
    file = files[0]
else:
    selection_prompt = (
        "Choose the intended file from the following exact filename search results. "
        "The filename must be exactly 'team-building-activities.docx'. "
        "If there are duplicate filenames, choose the most recently modified file. "
        "Return only the file_id of the selected file.\n\n"
        "Search results:\n" + repr(files)
    )
    selection = query_ai_assistant(selection_prompt, SelectedFile)
    matching_files = [f for f in files if f.id_ == selection.file_id]
    if len(matching_files) == 0:
        raise ValueError("The selected file_id did not match any file in the search results.")
    file = matching_files[0]

suggestion_prompt = (
    "You are helping Emma Johnson at Blue Sparrow Tech update a team-building activities document. "
    "Below is the current content of the file named 'team-building-activities.docx'. "
    "Suggest exactly two additional team-building activities that are not already covered by the existing content. "
    "Each activity must be suitable for a workplace team, clearly different from the existing activities, and written as a self-contained entry with a title and a concise description. "
    "Return exactly two entries in the fields activity_1 and activity_2. "
    "The text will be appended directly to the document, so make each field ready to append.\n\n"
    "Current file content:\n" + file.content
)

suggestions = query_ai_assistant(suggestion_prompt, SuggestedActivities)

separator = "" if file.content == "" else ("\n" if file.content.endswith("\n") else "\n\n")
append_content = separator + suggestions.activity_1 + "\n\n" + suggestions.activity_2
updated_file = append_to_file(file.id_, append_content)

print("Two suggested activities were added to 'team-building-activities.docx':")
print(suggestions.activity_1)
print(suggestions.activity_2)
```
