```python
class EventSelection(BaseModel):
    event_id: str

class ContactSelection(BaseModel):
    email: EmailStr

current_day = get_current_day()

events = search_calendar_events("Networking event", None)
if len(events) == 0:
    raise ValueError("No 'Networking event' found in the calendar.")

may26_events = [
    event for event in events
    if event.start_time.month == 5 and event.start_time.day == 26
]
if len(may26_events) == 0:
    raise ValueError("No 'Networking event' found on May 26th.")

exact_events = [
    event for event in may26_events
    if event.title.lower() == "networking event"
]

if len(exact_events) == 1:
    selected_event = exact_events[0]
elif len(may26_events) == 1:
    selected_event = may26_events[0]
else:
    events_info = "\n\n".join([event.model_dump_json() for event in may26_events])
    prompt = (
        f"The current date is {current_day}. "
        "Select the calendar event that best matches an event titled 'Networking event' "
        f"on May 26th. Here are the candidate events:\n\n{events_info}"
    )
    selection = query_ai_assistant(prompt, EventSelection)
    matching_events = [event for event in may26_events if event.id_ == selection.event_id]
    if len(matching_events) == 0:
        raise ValueError("The AI assistant selected an event that was not in the candidate list.")
    selected_event = matching_events[0]

contacts = search_contacts_by_name("Emma Johnson")
if len(contacts) == 0:
    raise ValueError("Could not find a contact for Emma Johnson.")
elif len(contacts) == 1:
    emma_email = contacts[0].email
else:
    contacts_info = "\n\n".join([contact.model_dump_json() for contact in contacts])
    prompt = (
        "Select the contact that is Emma Johnson. "
        f"Here are the candidate contacts:\n\n{contacts_info}"
    )
    selection = query_ai_assistant(prompt, ContactSelection)
    matching_contacts = [contact for contact in contacts if contact.email == selection.email]
    if len(matching_contacts) == 0:
        raise ValueError("The AI assistant selected a contact that was not in the candidate list.")
    emma_email = matching_contacts[0].email

other_invitees = [
    participant for participant in selected_event.participants
    if participant != emma_email
]

if len(other_invitees) == 0:
    print("No other participants are invited to the 'Networking event' on May 26th.")
else:
    print("Other invitees to the 'Networking event' on May 26th:")
    for email in other_invitees:
        print(email)
