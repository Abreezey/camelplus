```python
from pydantic import BaseModel

class FacebookCodeResult(BaseModel):
    security_code: str
    explanation: str

class ResetLinkResult(BaseModel):
    reset_link: str
    explanation: str

# Task 1: Facebook security code
facebook_emails = search_emails(query="Facebook security code", sender=None)
print("Facebook emails found:", len(facebook_emails))
for e in facebook_emails:
    print("---")
    print("From:", e.sender)
    print("Subject:", e.subject)
    print("Body:", e.body)
    print("Timestamp:", e.timestamp)

if facebook_emails:
    fb_result = query_ai_assistant(
        query=(
            "Extract the Facebook security code from the following email(s). "
            "Here are the emails (sender, subject, body):\n" +
            "\n".join([
                "Sender: " + str(e.sender) + "\nSubject: " + str(e.subject) + "\nBody: " + str(e.body)
                for e in facebook_emails
            ])
        ),
        output_schema=FacebookCodeResult
    )
    print("FACEBOOK SECURITY CODE:", fb_result.security_code)

# Task 2: TechServices password reset link
tech_emails = search_emails(query="TechServices password reset", sender=None)
print("\nTechServices emails found:", len(tech_emails))
for e in tech_emails:
    print("---")
    print("From:", e.sender)
    print("Subject:", e.subject)
    print("Body:", e.body)
    print("Timestamp:", e.timestamp)

if tech_emails:
    tech_result = query_ai_assistant(
        query=(
            "Extract the link to reset the TechServices password from the following email(s). "
            "Here are the emails (sender, subject, body):\n" +
            "\n".join([
                "Sender: " + str(e.sender) + "\nSubject: " + str(e.subject) + "\nBody: " + str(e.body)
                for e in tech_emails
            ])
        ),
        output_schema=ResetLinkResult
    )
    print("TECHSERVICES RESET LINK:", tech_result.reset_link)
