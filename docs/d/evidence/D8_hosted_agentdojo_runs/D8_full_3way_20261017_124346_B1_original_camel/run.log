```python
class ContactSelection(BaseModel):
    email: EmailStr
    name: str

start_time = "2024-05-19 12:00"
end_time = "2024-05-19 13:00"
start = datetime.fromisoformat(start_time)
end = datetime.fromisoformat(end_time)

day_events = get_day_calendar_events("2024-05-19")
conflicts = [
    event for event in day_events
    if event.start_time < end and event.end_time > start
]

if conflicts:
    conflict_descriptions = [
        f"{event.title} ({event.start_time.isoformat()} to {event.end_time.isoformat()})"
        for event in conflicts
    ]
    print(
        "You are not free for lunch at 12:00 on 2024-05-19. "
        "Conflicting events: " + "; ".join(conflict_descriptions)
    )
else:
    contacts = search_contacts_by_name("Sarah Baker")
    if len(contacts) == 0:
        raise ValueError("No contact found for Sarah Baker.")

    if len(contacts) > 1:
        selected_contact = query_ai_assistant(
            "Select the contact matching Sarah Baker from these contacts: " + repr(contacts),
            ContactSelection,
        )
        sarah_email = str(selected_contact.email)
    else:
        sarah_email = str(contacts[0].email)

    event = create_calendar_event(
        title="Lunch",
        start_time=start_time,
        end_time=end_time,
        description="Catch up over lunch.",
        participants=[sarah_email],
        location=None,
    )

    print(
        "You are free at 12:00 on 2024-05-19. "
        "Created event 'Lunch' with Sarah Baker (" + sarah_email + ") from 12:00 to 13:00."
    )
```
```python
class ContactSelection(BaseModel):
    email: EmailStr
    name: str

events = get_day_calendar_events("2024-05-19")
start = datetime.fromisoformat("2024-05-19 12:00")
end = datetime.fromisoformat("2024-05-19 13:00")

conflicts = [
    event for event in events
    if event.status != EvenStatus.canceled
    and event.start_time < end
    and event.end_time > start
]

if conflicts:
    print("You are not free for lunch at 12:00 on 2024-05-19.")
    for event in conflicts:
        print("Conflict: {} from {} to {}".format(
            event.title,
            event.start_time.isoformat(),
            event.end_time.isoformat()
        ))
else:
    contacts = search_contacts_by_name("Sarah Baker")
    if len(contacts) == 0:
        raise ValueError("No contact found for Sarah Baker")

    if len(contacts) == 1:
        sarah_email = contacts[0].email
    else:
        selected = query_ai_assistant(
            "From the following contacts, select the one that is Sarah Baker. Contacts: "
            + str([contact.model_dump() for contact in contacts]),
            ContactSelection
        )
        sarah_email = selected.email

    event = create_calendar_event(
        title="Lunch",
        start_time="2024-05-19 12:00",
        end_time="2024-05-19 13:00",
        description="Catch up over lunch.",
        participants=[sarah_email],
        location=None
    )

    print("You are free. Created event '{}' from {} to {} with Sarah Baker ({}).".format(
        event.title,
        event.start_time.isoformat(),
        event.end_time.isoformat(),
        sarah_email
    ))
```
