from pydantic import BaseModel

class PackingListOutput(BaseModel):
    content: str

# Step 1: Find the vacation plans document in the cloud drive
all_files = list_files()
plan_file = None
for file in all_files:
    if "hawaii" in file.filename.lower() and "packing" not in file.filename.lower():
        plan_file = file

if plan_file is None:
    raise ValueError("Could not find a Hawaii vacation plans document.")

print("Using vacation plan:", plan_file.filename)

# Step 2: Generate the packing list from the plan document using the AI assistant
query = (
    "Based on the following Hawaii vacation plan document, create a detailed and well-organized packing list "
    "for the trip. Organize the list into logical categories such as Clothing, Travel Documents, Beach Gear, "
    "Toiletries, and Electronics. Include items appropriate for the activities and duration mentioned in the plan. "
    "Return only the packing list content.\n\nVacation Plan Document:\n" + plan_file.content
)

packing_list = query_ai_assistant(query, PackingListOutput)

# Step 3: Create the new packing list file
new_file = create_file("hawaii-packing-list.docx", packing_list.content)
print("Created file:", new_file.filename, "| ID:", new_file.id_)

# Step 4: Share the file with john.doe@gmail.com with read permission
shared_file = share_file(new_file.id_, "john.doe@gmail.com", SharingPermission.r)
print("Shared with:", shared_file.shared_with)
```

This code:
1. Lists all files and finds the Hawaii vacation plans document (excluding any packing list file).
2. Uses `query_ai_assistant` to generate a structured packing list based on the plan content — avoiding any regex/string parsing.
3. Creates the new `hawaii-packing-list.docx` file.
4. Shares it with `john.doe@gmail.com` with read (`SharingPermission.r`) permissions.
