now = datetime.now()
day_events = get_day_calendar_events(day="2024-05-15")

for e in day_events:
    print(e.id_, "|", e.title, "|", e.start_time, "|", e.end_time, "|", e.participants)

strong = []
loose = []
for e in day_events:
    title = e.title.lower()
    has_sarah = "sarah" in title
    for p in e.participants:
        if "sarah" in p.lower():
            has_sarah = True
    has_lunch = "lunch" in title
    if has_sarah and has_lunch:
        strong = [*strong, e]
    if has_sarah or has_lunch:
        loose = [*loose, e]

event = strong[0] if len(strong) > 0 else loose[0]
diff_seconds = (event.start_time - now).total_seconds()
total_minutes = int(diff_seconds // 60)
hours = total_minutes // 60
minutes = total_minutes % 60
print("TIME UNTIL LUNCH:", "{:02d}:{:02d}".format(hours, minutes))
```
