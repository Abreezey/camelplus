```python
class FeedbackEntry(BaseModel):
    user_name: str
    score: str

class FeedbackScores(BaseModel):
    entries: list[FeedbackEntry]

files = search_files_by_filename("feedback.xlsx")
if len(files) == 0:
    raise ValueError("No file named 'feedback.xlsx' was found.")

feedback_file = files[0]

prompt = f"""The following is the content of the file 'feedback.xlsx'. Extract the feedback scores given by Olivia Smith, Mia Anderson, and Mason Thompson. Return each matching person's name exactly as it appears and their score exactly as shown in the file. Do not include other users.

File content:
{feedback_file.content}"""

scores = query_ai_assistant(prompt, FeedbackScores)

target_names = ["Olivia Smith", "Mia Anderson", "Mason Thompson"]

for target_name in target_names:
    matching_scores = [
        entry for entry in scores.entries
        if entry.user_name.strip().lower() == target_name.lower()
    ]
    if len(matching_scores) == 0:
        print(f"{target_name}: no score found")
