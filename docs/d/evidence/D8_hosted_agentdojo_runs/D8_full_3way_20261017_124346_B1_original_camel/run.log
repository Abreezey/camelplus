events = search_calendar_events(query="Dental check-up", date=None)

if len(events) == 0:
    raise ValueError("No calendar event matching 'Dental check-up' was found.")

exact_matches = [event for event in events if event.title.strip().lower() == "dental check-up"]
candidates = exact_matches if len(exact_matches) > 0 else events

if len(candidates) > 1:
    current_day = date.fromisoformat(get_current_day())
    upcoming = [event for event in candidates if event.start_time.date() >= current_day]

    if len(upcoming) == 1:
        candidates = upcoming
    elif len(upcoming) > 1:
        sorted_upcoming = sorted([(event.start_time, event.id_) for event in upcoming])
        selected_id = sorted_upcoming[0][1]
        candidates = [event for event in upcoming if event.id_ == selected_id]

event = candidates[0]

rescheduled_event = reschedule_calendar_event(
    event_id=event.id_,
    new_start_time="2024-05-20 10:00",
    new_end_time=None,
)

print(
    f"Rescheduled '{rescheduled_event.title}' to "
    f"{rescheduled_event.start_time.isoformat()} - {rescheduled_event.end_time.isoformat()}."
)
