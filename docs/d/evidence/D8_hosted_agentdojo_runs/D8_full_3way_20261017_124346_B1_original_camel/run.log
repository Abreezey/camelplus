from datetime import datetime
from pydantic import BaseModel

class LunchGapDetails(BaseModel):
    meeting_title: str
    meeting_end: datetime
    lunch_title: str
    lunch_start: datetime

events = get_day_calendar_events("2024-05-15")

if not events:
    raise ValueError("No calendar events found on 2024-05-15.")

events_text = str([event.model_dump() for event in events])

details = query_ai_assistant(
    query=(
        "Here are the calendar events for 2024-05-15: "
        f"{events_text}. "
        "Identify the meeting that occurs immediately before lunch, meaning the latest meeting "
        "that ends before the lunch event with Sarah. Also identify the lunch event with Sarah. "
        "Return the meeting title and its end time, and the lunch title and its start time."
    ),
    output_schema=LunchGapDetails,
)

gap_seconds = int((details.lunch_start - details.meeting_end).total_seconds())

if gap_seconds < 0:
    raise ValueError("The identified meeting ends after the lunch with Sarah starts.")

hours, remainder = divmod(gap_seconds, 3600)
minutes = remainder // 60

print("{:02d}:{:02d}".format(hours, minutes))
