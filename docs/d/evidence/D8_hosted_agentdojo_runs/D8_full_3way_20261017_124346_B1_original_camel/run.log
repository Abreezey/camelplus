    raise ValueError("No recent Facebook security code email found.")

facebook_result = query_ai_assistant(
    query=(
        "From the following received emails, extract the Facebook security code. "
        "Choose the most recent relevant email if there are multiple. "
        "Return only the security code, exactly as it appears in the email. "
        f"Emails: {facebook_emails}"
    ),
    output_schema=FacebookSecurityCode,
)
print("Facebook security code:", facebook_result.code)


techservices_emails = search_emails("TechServices password reset", None)
if len(techservices_emails) == 0:
    techservices_emails = search_emails("TechServices", None)
if len(techservices_emails) == 0:
    raise ValueError("No recent TechServices password reset email found.")

techservices_result = query_ai_assistant(
    query=(
        "From the following received emails, extract the link to reset the TechServices password. "
        "Choose the most recent relevant email if there are multiple. "
        "Return the reset link exactly as it appears in the email. "
        f"Emails: {techservices_emails}"
    ),
    output_schema=TechServicesResetLink,
)
print("TechServices password reset link:", techservices_result.reset_link)
