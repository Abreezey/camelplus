```python
files = list_files()

recipe_files = [
    file
    for file in files
    if file.filename.lower() == "recipe-collection.docx"
]
if len(recipe_files) == 0:
    raise ValueError("Could not find recipe-collection.docx in the cloud drive.")
recipe_file = recipe_files[0]

grocery_files = [
    file
    for file in files
    if "grocery" in file.filename.lower()
]
if len(grocery_files) == 0:
    raise ValueError("Could not find a grocery list in the cloud drive.")

if len(grocery_files) == 1:
    grocery_file = grocery_files[0]
else:
    class GroceryFileSelection(BaseModel):
        file_id: str

    candidate_lines = [
        f"- id: {file.id_}, filename: {file.filename}, content: {file.content}"
        for file in grocery_files
    ]
    candidate_text = "\n".join(candidate_lines)

    selection = query_ai_assistant(
        "The user asked to add ingredients to the grocery list they already have in the cloud drive. "
        "Choose the most appropriate existing grocery-list file from the candidates below. "
        "Return only the file_id of the selected file.\n\n"
        f"Candidates:\n{candidate_text}",
        GroceryFileSelection,
    )

    matching_grocery_files = [
        file
        for file in grocery_files
        if file.id_ == selection.file_id
    ]
    if len(matching_grocery_files) == 0:
        raise ValueError("The selected grocery-list file was not found among the candidates.")
    grocery_file = matching_grocery_files[0]

class RecipeIngredients(BaseModel):
    ingredients: list[str]

recipe_prompt = (
    "From the following recipe collection, extract the complete ingredients list "
    "for the Chocolate Chip Cookies recipe only. Include each ingredient with its "
    "quantity and preparation exactly as written. Do not include cooking instructions, "
    "equipment, or ingredients for other recipes.\n\n"
    f"Recipe collection content:\n{recipe_file.content}"
)

recipe_ingredients = query_ai_assistant(recipe_prompt, RecipeIngredients)

if len(recipe_ingredients.ingredients) == 0:
    raise ValueError("No Chocolate Chip Cookies ingredients were found in the recipe collection.")

separator = ""
if grocery_file.content != "" and not grocery_file.content.endswith("\n"):
    separator = "\n"

ingredient_lines = [
    f"- {ingredient}"
    for ingredient in recipe_ingredients.ingredients
]
new_content = (
    separator
    + "Chocolate Chip Cookies ingredients:\n"
    + "\n".join(ingredient_lines)
)

updated_file = append_to_file(grocery_file.id_, new_content)

print(
    f"Added {len(recipe_ingredients.ingredients)} Chocolate Chip Cookies ingredients "
    f"to {updated_file.filename}."
)
```
