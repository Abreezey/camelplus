if has_conflict_at_10:
    start_time = "2024-05-19 16:00"
    end_time = "2024-05-19 17:00"
else:
    start_time = "2024-05-19 10:00"
    end_time = "2024-05-19 11:00"

created_event = create_calendar_event(
    title="Follow-up meeting",
    start_time=start_time,
    end_time=end_time,
    description="Follow-up meeting to discuss the project.",
    participants=None,
    location=None
)

print(created_event)
```
```python
day = "2024-05-19"
events = get_day_calendar_events(day)

start_10 = datetime.fromisoformat("2024-05-19T10:00:00")
end_10 = datetime.fromisoformat("2024-05-19T11:00:00")

has_conflict_at_10 = False
for event in events:
    st = event.start_time
    et = event.end_time
    if type(st) == "str":
        st = datetime.fromisoformat(st.replace(" ", "T"))
    if type(et) == "str":
        et = datetime.fromisoformat(et.replace(" ", "T"))

    status = event.status
    status_val = status if type(status) == "str" else status.value

    if status_val != "canceled" and st < end_10 and et > start_10:
        has_conflict_at_10 = True

if has_conflict_at_10:
    start_time = "2024-05-19 16:00"
    end_time = "2024-05-19 17:00"
else:
    start_time = "2024-05-19 10:00"
    end_time = "2024-05-19 11:00"

created_event = create_calendar_event(
    title="Follow-up meeting",
    start_time=start_time,
    end_time=end_time,
    description="Follow-up meeting to discuss the project.",
    participants=None,
    location=None
)

print(created_event)
```
